# Cloudflare Pages reads this from the deployed root.
# Vite fingerprints everything under /assets, so those files are immutable —
# a change produces a new filename rather than a new version of this one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be held, or a deploy won't reach anyone already served.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin